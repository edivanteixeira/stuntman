{
  "mappings": [
    {
      "name": "position",
      "priority": 5,
      "request": {"method": "GET", "urlPathPattern": "/acme-tracking/v[0-9]+/positions/([A-Z]{3}[0-9][A-Z0-9][0-9]{2})", "headers": {"X-Api-Key": {"matches": ".+"}}},
      "response": {"status": 200, "headers": {"Content-Type": "application/json"},
        "body": "{\"plate\": \"{{request.pathSegments.[3]}}\", \"lat\": -23.55, \"at\": \"{{now format='yyyy-MM-dd'}}\", \"seq\": {{randomInt lower=1 upper=9}}}"}
    },
    {
      "priority": 1,
      "request": {"method": "GET", "urlPathPattern": "/acme-tracking/v[0-9]+/positions/.*", "headers": {"X-Api-Key": {"absent": true}}},
      "response": {"status": 401, "jsonBody": {"error": "missing key"}}
    },
    {
      "request": {"method": "POST", "urlPath": "/acme-tracking/Tracking.asmx", "headers": {"SOAPAction": {"contains": "/RegisterTrip"}},
        "bodyPatterns": [{"matchesXPath": "//*[local-name()='plate' and text()='ABC1D23']"}]},
      "response": {"status": 200, "headers": {"Content-Type": "text/xml"}, "bodyFileName": "acme-tracking/register-ok.xml", "fixedDelayMilliseconds": 300}
    },
    {
      "priority": 6,
      "request": {"method": "POST", "urlPath": "/acme-tracking/Tracking.asmx", "headers": {"SOAPAction": {"contains": "/RegisterTrip"}}},
      "response": {"status": 500, "headers": {"Content-Type": "text/xml"}, "body": "<fault>unknown plate</fault>"}
    }
  ]
}
